{
    "name": "semae/pca",
    "description": "backend para publicação e retificação de planos PCA no PNCP",
    "type": "project",

    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },

    "autoload": {
        "psr-4": {
            "Semae\\Pca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "authors": [
        {
            "name": "Jonatas Rodrigues Silva"
        }
    ],

    "minimum-stability": "stable",

    "scripts":{
        "start server":"php -S localhost:8080 -t public",
        "tests":"vendor/bin/phpunit",
        "tests:unit":"vendor/bin/phpunit --testsuite unit",
        "tests:integration":"vendor/bin/phpunit --testsuite integration",
        "tests:functional":"vendor/bin/phpunit --testsuite functional",
        "tests:contract":"vendor/bin/phpunit --testsuite contract",
        "tests:stage":"vendor/bin/phpunit --testsuite stage"
    }
}
