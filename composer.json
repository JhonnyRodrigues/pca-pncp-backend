{
    "name": "semae/pca",
    "description": "backend para publicação e retificação de planos PCA no PNCP",
    "type": "project",

    "require": {
        "php": "^8.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },

    "autoload": {
        "psr-4": {
            "Semae\\Pca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "authors": [
        {
            "name": "Jonatas Rodrigues Silva"
        }
    ],

    "minimum-stability": "stable",

    "scripts":{
        "start server":"php -S localhost:8080 -t public",
        "tests":"vendor/bin/phpunit",
        "contract:tests":"vendor/bin/phpunit --configuration phpunit.contract.xml --exclude-group pncp-live",
        "contract:preflight":"php tests/Contract/Sprint51/run-preflight.php",
        "contract:preflight:pncp":"php tests/Contract/Sprint51/run-preflight.php pncp",
        "contract:preflight:oracle":"php tests/Contract/Sprint51/run-preflight.php oracle",
        "contract:pncp":"vendor/bin/phpunit --configuration phpunit.contract.xml --group pncp-live"
    }
}
