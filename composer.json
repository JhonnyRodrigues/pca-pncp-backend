{
    "name": "semae/pca",
    "description": "Solução para publicar e manter o Plano de Contratações Anual (PCA) do SGI alinhado ao PNCP, com segurança e rastreabilidade.",
    "type": "project",
    "require": {
        "php": "^8.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "Semae\\Pca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Jonatas Rodrigues Silva"
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
        "check-psr4": "composer dump-autoload --optimize --strict-psr",
        "start server": "php -S localhost:8080 -t public",
        "tests": "vendor/bin/phpunit",
        "adapters:tests": "vendor/bin/phpunit tests/Infrastructure",
        "contract:tests": "vendor/bin/phpunit --testsuite contratos-externos --exclude-group pncp-live --do-not-cache-result",
        "contract:adapters:tests": "vendor/bin/phpunit --testsuite contratos-adapters --exclude-group pncp-live",
        "contract:adapters:preflight": "php tests/Contract/Sprint59/run-preflight.php",
        "contract:adapters:preflight:pncp": "php tests/Contract/Sprint59/run-preflight.php pncp",
        "contract:adapters:preflight:oracle": "php tests/Contract/Sprint59/run-preflight.php oracle",
        "contract:adapters:pncp:cleanup": "php tests/Contract/Sprint59/run-pncp-cleanup.php",
        "contract:adapters:pncp": "vendor/bin/phpunit --testsuite contratos-adapters --group pncp-live",
        "contract:oracle82:tests": "vendor/bin/phpunit --testsuite contratos-oracle",
        "contract:oracle82:preflight": "php tests/Contract/Sprint82/run-preflight.php",
        "contract:pncp83:preflight": "php tests/Contract/Sprint83/run-preflight.php",
        "contract:pncp83:tests": "vendor/bin/phpunit --testsuite contratos-pncp-treinamento --exclude-group pncp83-nominal-live,pncp83-uncertain-live",
        "contract:pncp83:nominal": "vendor/bin/phpunit --testsuite contratos-pncp-treinamento --group pncp83-nominal-live",
        "contract:pncp83:uncertain": "vendor/bin/phpunit --testsuite contratos-pncp-treinamento --group pncp83-uncertain-live",
        "contract:pncp83:cleanup": "php tests/Contract/Sprint83/run-pncp-cleanup.php",
        "contract:sprint84:tests": "vendor/bin/phpunit --testsuite fluxos-completos --exclude-group sprint84-live",
        "contract:sprint84:preflight": "php tests/Contract/Sprint84/run-preflight.php",
        "contract:sprint85:tests": "vendor/bin/phpunit --testsuite falhas-e-preparacao --exclude-group sprint85-live",
        "contract:sprint85:preflight": "php tests/Contract/Sprint85/run-preflight.php",
        "contract:sprint85:queries": "php tests/Contract/Sprint85/render-manual-queries.php",
        "contract:sprint94:tests": "vendor/bin/phpunit --testsuite inventario-e-recuperacao --exclude-group sprint94-live",
        "package:build": "php tools/package/build.php",
        "package:verify": "php tools/package/verify.php",
        "package:archive": "php tools/package/archive.php",
        "package:release": [
            "@package:build",
            "@package:verify",
            "@package:archive"
        ],
        "package:sprint85": "php tools/package/build.php",
        "package:sprint85:verify": "php tools/package/verify.php",
        "package:sprint85:log-gate": "php tools/package/build-log-gate.php",
        "package:sprint85:log-gate:verify": "php tools/package/verify-log-gate.php",
        "package:sprint85:containment-gate": "php tools/package/build-containment-gate.php",
        "package:sprint85:containment-gate:verify": "php tools/package/verify-containment-gate.php",
        "package:sprint94:inventory-gate": "php tools/package/build-sprint94-inventory-gate.php",
        "package:sprint94:inventory-gate:verify": "php tools/package/verify-sprint94-inventory-gate.php",
        "package:sprint94:correction-3a": "php tools/package/build-sprint94-correction-3a.php",
        "package:sprint94:correction-3a:verify": "php tools/package/verify-sprint94-correction-3a.php",
        "package:sprint94:correction-3a:archive": "php tools/package/archive-sprint94-correction-3a.php",
        "contract:preflight": "php tests/Contract/Sprint51/run-preflight.php",
        "contract:preflight:pncp": "php tests/Contract/Sprint51/run-preflight.php pncp",
        "contract:preflight:oracle": "php tests/Contract/Sprint51/run-preflight.php oracle",
        "contract:pncp": "vendor/bin/phpunit --testsuite contratos-externos --group pncp-live --do-not-cache-result"
    }
}
