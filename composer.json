{
    "name": "semae/pca",
    "description": "backend para publicação e retificação de planos PCA no PNCP",
    "type": "project",

    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },

    "autoload": {
        "psr-4": {
            "Semae\\Pca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "authors": [
        {
            "name": "Jonatas Rodrigues Silva"
        }
    ],

    "minimum-stability": "stable",

    "scripts":{
        "start server":"php -S localhost:8080 public/index.php",
        "tests":"vendor/bin/phpunit"
    }
}
